{
  "name": "choice-practice",
  "version": "1.0.6",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "markdown-it": "^14.3.3",
    "markdown-it-cjk-friendly": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api": "node scripts/api.mjs",
    "generate:bank": "python3 scripts/generate.py",
    "check:bank": "node scripts/check-bank.mjs",
    "test": "node scripts/test-domain.mjs && node scripts/test-tutor.mjs && node scripts/test-android-back.mjs && node scripts/test-bank-policy.mjs && node scripts/test-markdown.mjs",
    "review:bank": "python3 scripts/review.py",
    "postinstall": "node scripts/provision-local-key.mjs",
    "provision:key": "node scripts/provision-local-key.mjs",
    "provision:public": "node scripts/provision-local-key.mjs --public"
  },
  "private": true,
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "$markdown-it"
    }
  }
}
